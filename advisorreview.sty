\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{advisorreview}[2026/10/26 Layout-preserving PDF review annotations]

\newif\ifadvisorreviewhighlight
\newif\ifadvisorreviewcomments
\newif\ifadvisorreviewhidelinks
\newif\ifadvisorreviewcjk

\advisorreviewhighlighttrue
\advisorreviewcommentstrue
\advisorreviewhidelinkstrue
\advisorreviewcjkfalse

\newcommand{\advisorreviewauthor}{Johnnie}

\DeclareOption{advisor}{%
  \advisorreviewhighlighttrue
  \advisorreviewcommentstrue
}
\DeclareOption{review}{%
  \advisorreviewhighlighttrue
  \advisorreviewcommentstrue
}
\DeclareOption{reviewer}{%
  \advisorreviewhighlighttrue
  \advisorreviewcommentsfalse
}
\DeclareOption{clean}{%
  \advisorreviewhighlightfalse
  \advisorreviewcommentsfalse
}
\DeclareOption{final}{%
  \advisorreviewhighlightfalse
  \advisorreviewcommentsfalse
}
\DeclareOption{hidelinks}{\advisorreviewhidelinkstrue}
\DeclareOption{visiblelinks}{\advisorreviewhidelinksfalse}
\DeclareOption{cjk}{\advisorreviewcjktrue}
\ExecuteOptions{advisor,hidelinks}
\ProcessOptions\relax

\RequirePackage{xcolor}
\RequirePackage{iftex}

% mathcolor preserves atom classes and handles scripts outside the marked text.
\ifdefined\mathcolor\else
  \InputIfFileExists{mathcolor.ltx}{}{%
    \PackageWarning{advisorreview}{mathcolor.ltx not found; include complete
      subscripts, superscripts and operator limits inside marked arguments}%
  }%
\fi
\providecommand{\mathcolor}[2]{\begingroup\color{#1}#2\endgroup}

\definecolor{advisorreviewblue}{RGB}{0, 0, 255}

\ifadvisorreviewhidelinks
  \PassOptionsToPackage{hidelinks}{hyperref}
\fi

\ifadvisorreviewcjk
  \IfFileExists{CJKutf8.sty}{%
    \RequirePackage{CJKutf8}
    \AtBeginDocument{\begin{CJK*}{UTF8}{gbsn}}
    \AtEndDocument{\end{CJK*}}
  }{%
    \PackageWarning{advisorreview}{Option cjk was requested, but CJKutf8.sty was not found}%
  }
\fi

\newif\ifadvisorreviewpdfcomment
\advisorreviewpdfcommentfalse
\IfFileExists{pdfcomment.sty}{%
  \RequirePackage{pdfcomment}
  \advisorreviewpdfcommenttrue
}{%
  \PackageWarning{advisorreview}{pdfcomment.sty not found; advisor notes will use visible fallback markers}%
}
\providecommand\HyperFirstAtBeginDocument[1]{#1}

% The one-click builder can reuse this PDF instead of compiling this mode twice.
\AtBeginDocument{%
  \ifadvisorreviewhighlight
    \ifadvisorreviewcomments
      \typeout{ADVISORREVIEW-MODE:advisor}%
    \else
      \typeout{ADVISORREVIEW-MODE:reviewer}%
    \fi
  \else
    \typeout{ADVISORREVIEW-MODE:clean}%
  \fi
}

\makeatletter
\ifadvisorreviewhidelinks
  \AtBeginDocument{%
    \@ifpackageloaded{hyperref}{\hypersetup{hidelinks}}{}%
  }
\fi
\makeatother

\makeatletter
\newcommand{\advisorreview@comment}[2]{%
  \ifadvisorreviewcomments
    \ifadvisorreviewpdfcomment
      \ifvmode\leavevmode\fi
      \begingroup
        % Encode strings in text mode without adding a box to the math list.
        \setbox\@tempboxa=\hbox{%
          \pdfstringdef\advisorreview@contents{#2}%
          \pdfstringdef\advisorreview@author{\advisorreviewauthor}%
        }%
        \def\advisorreview@annotation{%
          /Subtype /Text /Name /#1 /C [0 0 1]
          /T (\advisorreview@author) /Subj (Revision note)
          /Contents (\advisorreview@contents) /Open false /F 4
        }%
        % Native annotation whatsits have no width, height or math atom class.
        % The icon rectangle is above the baseline; it does not reserve space.
        \ifPDFTeX
          \pdfannot width 8bp height 18bp depth -10bp
            {\advisorreview@annotation}%
        \else\ifLuaTeX
          \pdfextension annot width 8bp height 18bp depth -10bp
            {\advisorreview@annotation}%
        \else\ifXeTeX
          \special{pdf: ann width 8bp height 18bp depth -10bp
            <<\advisorreview@annotation>>}%
        \else
          \ifmmode
            \vadjust{\smash{\hbox{\pdfcomment[icon=#1,
              author={\advisorreviewauthor},subject={Revision note}]{#2}}}}%
          \else
            \pdfcomment[icon=#1,author={\advisorreviewauthor},
              subject={Revision note}]{#2}%
          \fi
        \fi\fi\fi
        \ifPDFTeX
          \advisorreview@listentry
        \else\ifLuaTeX
          \advisorreview@listentry
        \else\ifXeTeX
          \advisorreview@listentry
        \fi\fi\fi
      \endgroup
    \else
      \ifmmode
        \vadjust{\smash{\hbox{\textcolor{red}{[review note]}}}}%
      \else
        \textsuperscript{\textcolor{red}{[review note]}}%
      \fi
    \fi
  \fi
}

\newcommand{\advisorreview@listentry}{%
  \addcontentsline{lpc}{lpcsec}{\protect\numberline{}\advisorreviewauthor\ - Revision note}%
}

\newcommand{\advisorreviewcomment}[1]{\advisorreview@comment{Comment}{#1}}
\newcommand{\pdfrevnote}[1]{\advisorreview@comment{Note}{#1}}

\newcommand{\advisorreview@textmark}[2]{%
  \ifadvisorreviewhighlight
    \begingroup\color{advisorreviewblue}#1\endgroup
    \advisorreviewcomment{#2}%
  \else
    #1%
  \fi
}

\newcommand{\pdfrevmark}[2]{%
  \ifmmode
    \expandafter\pdfrevformula
  \else
    \expandafter\advisorreview@textmark
  \fi{#1}{#2}%
}

\newcommand{\pdfrevmath}[2]{\pdfrevmark{#1}{#2}}

\newcommand{\advisorreview@mathmark}[2]{%
  \advisorreviewcomment{#2}%
  \mathcolor{advisorreviewblue}{#1}%
}

\newcommand{\pdfrevformula}[2]{%
  \ifadvisorreviewhighlight
    \expandafter\advisorreview@mathmark
  \else
    \expandafter\@firstoftwo
  \fi{#1}{#2}%
}

\newcommand{\pdfrevblock}[2]{\advisorreview@textmark{#1}{#2}}
\makeatother

\newcommand{\printpdfreviewlist}{%
  \ifadvisorreviewcomments
    \ifadvisorreviewpdfcomment
      \listofpdfcomments
    \fi
  \fi
}
